# Environment variables for local development (copy to .env and adjust as needed)
# Go application database connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cricket_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable

# Go application logging
# LOG_FORMAT: json|text
LOG_FORMAT=json
# LOG_LEVEL: debug|info|warn|error
LOG_LEVEL=info

# Go application optional paths/config
# Path to go-app/config.json if you want to override defaults
GO_APP_CONFIG=
# Input and output dirs used by various commands (defaults are relative to repo)
GO_APP_INPUT_DIR=./data/go-app
GO_APP_OUTPUT_DIR=./output/go-app
# Location of SQL migrations (used by make migrate and cmd/migrate)
MIGRATIONS_DIR=./go-app/migrations

# API service port (used by make api)
PORT=8080

ML_SERVICE_OUTPUT_DIR=./output/ml-service
# Base URL for go-app when ML calls back (train-on-the-fly, fielding/extras/win training).
# For Docker (make dev-up): leave unset so the ML container uses http://go-api:8080.
# For host-only runs (e.g. make train-fielding CUTOFF=...): set GO_APP_URL=http://localhost:8080 if needed.
# GO_APP_URL=
# Base URL for ML service when go-app calls predict/backtest
ML_SERVICE_URL=http://localhost:8000

# API key for admin endpoints (Ops Status, Evaluate, pipeline). Frontend uses dev-local-key by default.
# API_KEY=

# Pipeline resource limits (optional). With GOMEMLIMIT set, concurrency is auto-derived (80% for workers).
# MB-per-worker is learned from actual runs (heap/concurrency) and saved to resource_observations.json;
# set USE_RESOURCE_OBSERVATIONS=false to use config/constants only. RESOURCE_OBSERVATIONS_PATH overrides file location.
# Override per pipeline: PRECOMPUTE_CONCURRENCY, IMPORT_CONCURRENCY, EXPORT_CONCURRENCY, SEQCALC_CONCURRENCY, FIELDING_CONCURRENCY.
#
# Example for 12 CPUs / ~22GB RAM (Docker): use more cores and memory so pipelines don't sit at ~1 CPU.
# GOMEMLIMIT=8GiB
# PRECOMPUTE_CONCURRENCY=8
# IMPORT_CONCURRENCY=12
# EXPORT_CONCURRENCY=8
# SEQCALC_CONCURRENCY=4
# FIELDING_CONCURRENCY=6
#
# Example for 48GB RAM / M4 Pro (12 cores): GOMEMLIMIT=40GiB, PRECOMPUTE_CONCURRENCY=24, IMPORT_CONCURRENCY=48, EXPORT_CONCURRENCY=24, SEQCALC_CONCURRENCY=24, FIELDING_CONCURRENCY=12.
# GOMEMLIMIT=
# PRECOMPUTE_CONCURRENCY=
# IMPORT_CONCURRENCY=
# EXPORT_CONCURRENCY=
# SEQCALC_CONCURRENCY=
# FIELDING_CONCURRENCY=

# ML service: max concurrent /admin/train/* jobs (batting, bowling, fielding, etc.). Example for 12 CPUs.
# MAX_CONCURRENT_TRAINING_JOBS=4
# ML service: within each train step, max formats trained in parallel. Example for 12 CPUs.
# ML_TRAIN_FORMAT_WORKERS=4
