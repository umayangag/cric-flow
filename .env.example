# Environment variables for local development (copy to .env and adjust as needed)
# Go application database connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cricket_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable

# Go application logging
# LOG_FORMAT: json|text
LOG_FORMAT=json
# LOG_LEVEL: debug|info|warn|error
LOG_LEVEL=info

# Go application optional paths/config
# Path to go-app/config.json if you want to override defaults
GO_APP_CONFIG=
# Input and output dirs used by various commands (defaults are relative to repo)
GO_APP_INPUT_DIR=./data/go-app
GO_APP_OUTPUT_DIR=./output/go-app
# Location of SQL migrations (used by make migrate and cmd/migrate)
MIGRATIONS_DIR=./go-app/migrations

# API service port (used by make api)
PORT=8080

ML_SERVICE_OUTPUT_DIR=./output/ml-service
# X-4: where `make evaluate` reads cached closing-odds CSVs for the market benchmark.
# Never committed (the source grants no redistribution right); absent means the benchmark
# reports zero coverage rather than failing. Odds are a yardstick, never a model input.
# ML_MARKET_ODDS_DIR=./data/market-odds
# Base URL for go-app when ML calls back (train-on-the-fly, fielding/extras/win training).
# For Docker (make dev-up): leave unset so the ML container uses http://go-api:8080.
# For host-only runs (e.g. make train-fielding CUTOFF=...): set GO_APP_URL=http://localhost:8080 if needed.
# GO_APP_URL=
# Base URL for ML service when go-app calls predict/backtest
ML_SERVICE_URL=http://localhost:8000

# API key for admin endpoints (Ops Status, Evaluate, pipeline). Frontend uses dev-local-key by default.
# API_KEY=

# Pipeline resource limits — leave unset for auto (detects cgroup/memory and CPU, uses ~80%).
# Set only to override: GOMEMLIMIT, IMPORT_CONCURRENCY.
# USE_RESOURCE_OBSERVATIONS=false to ignore learned MB-per-worker; RESOURCE_OBSERVATIONS_PATH to override observations file.

# Postgres container memory cap (docker-compose mem_limit). Default 3g. Raise only if the DB
# needs more cache; it shares the Docker VM's memory with go-api and ml-service.
# POSTGRES_MEM_LIMIT=3g

# ML service — leave unset for auto (detects cgroup memory, 80% for n_jobs). Set only to override:
# ML_MEMORY_LIMIT_MB, ML_N_JOBS, ML_N_JOBS_MAX. MAX_CONCURRENT_TRAINING_JOBS (default 4) for /admin/train/* concurrency.
