#!/usr/bin/env bash
set -euo pipefail

# Root of repo
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Check for partially staged files to prevent accidental staging of unstaged changes
UNSTAGED_FILES=$(git diff --name-only)
# Find intersection
PARTIALLY_STAGED=$(comm -12 <(echo "$STAGED_FILES" | sort) <(echo "$UNSTAGED_FILES" | sort))

if [ -n "$PARTIALLY_STAGED" ]; then
    echo "[pre-commit] ⚠️  WARNING: Partially staged files detected:"
    echo "$PARTIALLY_STAGED" | sed 's/^/  - /'
    echo "[pre-commit] Auto-formatting is disabled for these files to avoid staging unstaged changes."
    echo "[pre-commit] Please stage the full file or stash unstaged changes and try again."
    exit 1
fi

echo "[pre-commit] optimized check on modified files..."

# --- Go App ---
GO_FILES=$(echo "$STAGED_FILES" | grep "^go-app/.*\.go$" || true)
if [ -n "$GO_FILES" ]; then
    echo "[go-app] Processing $(echo "$GO_FILES" | wc -l | xargs) Go files..."
    
    # Ensure tools are in PATH (match Makefile behavior)
    GOBIN="$(go env GOPATH)/bin"
    export PATH="${GOBIN}:$PATH"

    # Check for tools
    if ! command -v gofumpt >/dev/null 2>&1 || ! command -v golines >/dev/null 2>&1; then
        echo "[go-app] Installing formatters (gofumpt, golines)..."
        go install mvdan.cc/gofumpt@latest
        go install github.com/segmentio/golines@latest
    fi

    # Format
    echo "$GO_FILES" | xargs gofumpt -w
    echo "$GO_FILES" | xargs golines -w -m 120
    
    # Stage changes
    echo "$GO_FILES" | xargs git add

    # Lint (golangci-lint)
    if command -v golangci-lint >/dev/null 2>&1; then
        CONFIG=".golangci.yml"
        if [ -f "$CONFIG" ]; then
             echo "[go-app] Linting (and fixing) modified packages..."
             # Run on packages (directories) to ensure typechecking works
             GO_DIRS=$(echo "$GO_FILES" | xargs -n1 dirname | sort -u | xargs)
             golangci-lint run --fix -c "$CONFIG" $GO_DIRS
             
             # Stage changes (re-stage modified files)
             echo "$GO_FILES" | xargs git add
        else
             echo "[go-app] No .golangci.yml found, skipping lint."
        fi
    else
        echo "[go-app] golangci-lint not found, skipping lint."
    fi
fi

# --- Python (ml-service) ---
PY_FILES=$(echo "$STAGED_FILES" | grep "^ml-service/.*\.py$" || true)
if [ -n "$PY_FILES" ]; then
    echo "[ml-service] Processing $(echo "$PY_FILES" | wc -l | xargs) Python files..."
    
    VENV="ml-service/.venv"
    BIN="$VENV/bin"
    
    if [ ! -d "$VENV" ]; then
        echo "[ml-service] Virtualenv not found at $VENV. Skipping (run 'make init-py' to fix)."
    else
        # Format: isort -> black
        echo "$PY_FILES" | xargs "$BIN/isort" --profile black --line-length 120
        echo "$PY_FILES" | xargs "$BIN/black" --line-length 120
        
        # Stage changes
        echo "$PY_FILES" | xargs git add
        
        # Lint: ruff check --fix
        echo "$PY_FILES" | xargs "$BIN/ruff" check --fix
        echo "$PY_FILES" | xargs git add
        
        # Check only (gates)
        echo "$PY_FILES" | xargs "$BIN/ruff" check --select F401
        echo "$PY_FILES" | xargs "$BIN/flake8" --max-line-length=120 --extend-ignore=E203,E501,W503
    fi
fi

# --- Frontend ---
FE_FILES=$(echo "$STAGED_FILES" | grep "^frontend/.*\.\(js\|jsx\|ts\|tsx\|json\|css\|scss\|md\)$" || true)
if [ -n "$FE_FILES" ]; then
    echo "[frontend] Processing $(echo "$FE_FILES" | wc -l | xargs) files..."
    
    if [ ! -d "frontend/node_modules" ]; then
        echo "[frontend] node_modules not found. Skipping (run 'make -C frontend install' to fix)."
    else
        REL_FILES=$(echo "$FE_FILES" | sed 's/^frontend\///')
        
        pushd frontend >/dev/null
        
        # Prettier (write)
        echo "$REL_FILES" | xargs npx --no-install prettier --write
        
        # ESLint (fix)
        CODE_FILES=$(echo "$REL_FILES" | grep "\.\(js\|jsx\|ts\|tsx\)$" || true)
        if [ -n "$CODE_FILES" ]; then
            echo "$CODE_FILES" | xargs npx --no-install eslint --fix --quiet --no-error-on-unmatched-pattern
        fi
        
        # Stage changes
        echo "$REL_FILES" | xargs git add
        
        popd >/dev/null
    fi
fi

echo "[pre-commit] Done."
