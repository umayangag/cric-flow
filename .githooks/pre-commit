#!/usr/bin/env bash
set -euo pipefail

# Root of repo
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "[pre-commit] Running project formatters and linters via Makefiles..."

# --- Go app: format, check, lint ---
if [ -d "go-app" ]; then
  echo "[pre-commit][go-app] make fmt fmt-check lint"
  make -C go-app fmt
  make -C go-app fmt-check
  make -C go-app lint
fi

# --- Python (ml-service): lint autofix (ruff F401), format, then check gates ---
if [ -d "ml-service" ]; then
  echo "[pre-commit][ml-service] make lint fmt fmt-check lint-check"
  make -C ml-service lint
  make -C ml-service fmt
  make -C ml-service fmt-check
  make -C ml-service lint-check
fi

# --- Frontend: format and check (Prettier + ESLint if configured) ---
if [ -d "frontend" ] && [ -f "frontend/package.json" ]; then
  echo "[pre-commit][frontend] make fmt fmt-check typecheck test"
  make -C frontend fmt
  make -C frontend fmt-check
  make -C frontend typecheck
  make -C frontend test
fi

echo "[pre-commit] All format and lint checks passed."
