[run]
# Measure coverage for all application and ML code (app + ml)
source = app, ml
branch = True
omit =
    */.venv/*
    */tests/*
    */__init__.py
    # CLI training scripts (invoked as main; covered by integration/e2e)
    */ml/train_batting.py
    */ml/train_bowling.py
    */ml/train_fielding.py
    */ml/train_extras.py
    */ml/train_win.py
    */ml/train_combination_meta.py
    */ml/train_batting_model.py
    */ml/train_bowling_model.py
    */ml/walk_forward.py
    */ml/validate_exports.py
    */ml/batting_regressor.py
    */ml/bowling_regressor.py
    */ml/auto_tune.py
    */ml/auto_tune_autogluon.py
    */ml/auto_tune_pycaret.py

[report]
show_missing = True
skip_covered = False
precision = 2
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.: 
