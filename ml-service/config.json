{
  "inputs": {
    "go_app_export_dir": "../output/go-app",
    "training_data_fetch_timeout_sec": 604800,
    "training_subprocess_timeout_sec": 604800
  },
  "outputs": {
    "artifacts_dir": "../output/ml-service"
  },
  "ml": {
    "use_share_models": false,
    "formats": [
      "TEST",
      "ODI",
      "T20",
      "T20I"
    ],
    "artifact_template": "{kind}_{name}_{format}.joblib",
    "training": {
      "batting": {
        "n_estimators": 200,
        "max_depth": 12,
        "random_state": 42,
        "joblib_compress": 3
      },
      "bowling": {
        "n_estimators": 200,
        "max_depth": 12,
        "random_state": 42,
        "joblib_compress": 3
      },
      "fielding": {
        "n_estimators": 150,
        "max_depth": 10,
        "random_state": 42,
        "joblib_compress": 3,
        "n_jobs": 1
      },
      "extras": {
        "n_estimators": 100,
        "max_depth": 8,
        "random_state": 42,
        "joblib_compress": 3,
        "n_jobs": 1
      },
      "win": {
        "n_estimators": 100,
        "max_depth": 8,
        "max_depth_cap": 6,
        "random_state": 42,
        "joblib_compress": 3,
        "n_jobs": 1
      },
      "innings": {
        "n_estimators": 100,
        "max_depth": 8,
        "random_state": 42,
        "joblib_compress": 3,
        "n_jobs": 1
      }
    },
    "tuning": {
      "cv_splits": 5,
      "n_iter": 40,
      "scoring": "neg_mean_absolute_error",
      "n_jobs": -1,
      "random_state": 42,
      "algorithms": "all",
      "validation_method": "walk_forward",
      "permutation_importance_n_repeats": 5,
      "permutation_importance_decimal_places": 6
    },
    "cv_splits": 5,
    "test_size": 0.2,
    "learning_rate": 0.1,
    "subsample": 1,
    "colsample_bytree": 1,
    "reg_lambda": 1,
    "reg_alpha": 0,
    "early_stopping_rounds": 50,
    "max_iter": 1000,
    "feature_defaults": {
      "common": {
        "temp": 25,
        "humidity": 50,
        "wind": 0,
        "rain": 0,
        "cloud": 0,
        "pressure": 0,
        "viscosity": 0,
        "inning": 1,
        "session": 1,
        "toss": 0
      },
      "fielding": {
        "consistency": 0.5,
        "form": 0.0,
        "venue": 0.5,
        "opposition": 0.5
      }
    },
    "prediction_defaults": {
      "economy": 6.0,
      "bowling_deliveries_by_format": {
        "T20": 24,
        "T20I": 24,
        "ODI": 60,
        "TEST": 60
      }
    },
    "feature_transforms": {
      "batting": {
        "add_interactions": [
          ["batting_mean_w5", "batting_venue"],
          ["batting_std_w10", "batting_mean_w5"],
          ["batting_trend_w5", "inning"]
        ],
        "add_log1p": ["batting_career_count", "batting_days_since_last", "batting_innings_in_last_90d"]
      },
      "bowling": {
        "add_interactions": [
          ["bowling_mean_w5", "bowling_venue"],
          ["bowling_std_w10", "bowling_mean_w5"],
          ["bowling_trend_w5", "inning"]
        ],
        "add_log1p": ["bowling_career_count", "bowling_days_since_last", "bowling_innings_in_last_90d"]
      },
      "fielding": {
        "add_interactions": [],
        "add_log1p": []
      }
    },
    "mlqa": {
      "overfitting_delta_threshold": 0.10,
      "stability_fold_std_threshold": 0.08,
      "bias_dip_low": 0.8,
      "bias_dip_high": 1.25,
      "sensitivity_top_weight_threshold": 0.7,
      "sensitivity_top_n_features": 3
    }
  },
  "team_prediction": {
    "team_size": 11,
    "max_wickets_per_innings": 10
  }
}
