{
  "inputs": {"go_app_export_dir": "../output/go-app"},
  "outputs": {"artifacts_dir": "../output/ml-service"},
  "ml": {
    "formats": ["TEST", "ODI", "T20", "T20I"],
    "artifact_template": "{kind}_{name}_{format}.joblib",
    "training": {
      "n_estimators": 200,
      "max_depth": 12,
      "random_state": 42,
      "joblib_compress": 3
    },
    "cv_splits": 5,
    "test_size": 0.2,
    "learning_rate": 0.1,
    "subsample": 1,
    "colsample_bytree": 1,
    "reg_lambda": 1,
    "reg_alpha": 0,
    "early_stopping_rounds": 50,
    "max_iter": 1000
  },
  "team_prediction": {"team_size": 11, "default_extras": 14.26}
}
