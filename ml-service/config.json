{
  "inputs": {"go_app_export_dir": "../output/go-app"},
  "outputs": {"artifacts_dir": "../output/ml-service"},
  "ml": {
    "formats": ["TEST", "ODI", "T20", "T20I"],
    "artifact_template": "{kind}_{name}_{format}.joblib",
    "training": {
      "batting": {"n_estimators": 200, "max_depth": 12, "random_state": 42, "joblib_compress": 3},
      "bowling": {"n_estimators": 200, "max_depth": 12, "random_state": 42, "joblib_compress": 3},
      "fielding": {"n_estimators": 150, "max_depth": 10, "random_state": 42, "joblib_compress": 3},
      "extras": {"n_estimators": 100, "max_depth": 8, "random_state": 42, "joblib_compress": 3},
      "win": {"n_estimators": 100, "max_depth": 8, "random_state": 42, "joblib_compress": 3}
    },
    "tuning": {
      "cv_splits": 5,
      "n_iter": 25,
      "scoring": "neg_mean_absolute_error"
    },
    "cv_splits": 5,
    "test_size": 0.2,
    "learning_rate": 0.1,
    "subsample": 1,
    "colsample_bytree": 1,
    "reg_lambda": 1,
    "reg_alpha": 0,
    "early_stopping_rounds": 50,
    "max_iter": 1000
  },
  "team_prediction": {"team_size": 11}
