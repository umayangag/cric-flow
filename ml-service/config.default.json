{
  "inputs": {
    "go_app_export_dir": "../output/go-app",
    "training_data_fetch_timeout_sec": 604800,
    "training_data_fetch_timeout_invalid_fallback_sec": 600,
    "training_subprocess_timeout_sec": 604800,
    "go_app_request_timeout_sec": 30
  },
  "outputs": {
    "artifacts_dir": "../output/ml-service"
  },
  "ml": {
    "formats": ["TEST", "ODI", "T20", "T20I"],
    "artifact_template": "{kind}_{name}_{format}.joblib",
    "training": {
      "batting": {"n_estimators": 200, "max_depth": 12, "random_state": 42, "joblib_compress": 3},
      "bowling": {"n_estimators": 200, "max_depth": 12, "random_state": 42, "joblib_compress": 3},
      "fielding": {"n_estimators": 150, "max_depth": 10, "random_state": 42, "joblib_compress": 3},
      "extras": {"n_estimators": 100, "max_depth": 8, "random_state": 42, "joblib_compress": 3},
      "win": {"n_estimators": 100, "max_depth": 8, "random_state": 42, "joblib_compress": 3}
    },
    "resources": {
      "training_mb_per_job": 400,
      "tuning_mb_per_job": 500,
      "prediction_mb_per_job": 100,
      "memory_usage_fraction_percent": 70
    },
    "tuning": {
      "cv_splits": 5,
      "n_iter": 25,
      "n_jobs": -1,
      "random_state": 42,
      "scoring": "neg_mean_absolute_error",
      "algorithms": "all",
      "validation_method": "kfold",
      "search_space": {
        "rf": {
          "n_estimators": [50, 100, 150, 200, 300],
          "max_depth": [6, 8, 10, 12, 16, 20, null],
          "min_samples_split": [2, 5, 10],
          "min_samples_leaf": [1, 2, 4]
        },
        "gb": {
          "n_estimators": [50, 100, 150, 200],
          "max_depth": [3, 4, 5, 6, 8],
          "learning_rate": [0.01, 0.05, 0.1],
          "min_samples_split": [2, 5],
          "min_samples_leaf": [1, 2]
        }
      }
    },
    "feature_defaults": {
      "common": {
        "temp": 25,
        "humidity": 50,
        "wind": 0,
        "rain": 0,
        "cloud": 0,
        "pressure": 0,
        "viscosity": 0,
        "inning": 1,
        "session": 1,
        "toss": 0
      },
      "fielding": {
        "consistency": 0.5,
        "form": 0,
        "venue": 0.5,
        "opposition": 0.5
      }
    },
    "prediction_defaults": {
      "economy": 6.0
    }
  },
  "team_prediction": {
    "team_size": 11,
    "max_wickets_per_innings": 10
  }
}
