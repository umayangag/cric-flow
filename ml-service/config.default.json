{
  "inputs": {
    "go_app_export_dir": "../output/go-app",
    "training_data_fetch_timeout_sec": 14400,
    "training_data_fetch_timeout_invalid_fallback_sec": 600,
    "training_subprocess_timeout_sec": 14400,
    "go_app_request_timeout_sec": 30
  },
  "outputs": {
    "artifacts_dir": "../output/ml-service"
  },
  "ml": {
    "use_share_models": false,
    "formats": [
      "TEST",
      "ODI",
      "T20",
      "T20I"
    ],
    "artifact_template": "{kind}_{name}_{format}.joblib",
    "training": {
      "batting": {
        "n_estimators": 200,
        "max_depth": 12,
        "random_state": 42,
        "joblib_compress": 3,
        "n_jobs": -1
      },
      "bowling": {
        "n_estimators": 200,
        "max_depth": 12,
        "random_state": 42,
        "joblib_compress": 3,
        "n_jobs": -1,
        "target_clip_percentile": 97
      },
      "fielding": {
        "n_estimators": 150,
        "max_depth": 10,
        "random_state": 42,
        "joblib_compress": 3,
        "n_jobs": -1
      },
      "extras": {
        "n_estimators": 100,
        "max_depth": 8,
        "random_state": 42,
        "joblib_compress": 3,
        "n_jobs": -1
      },
      "win": {
        "n_estimators": 100,
        "max_depth": 8,
        "random_state": 42,
        "joblib_compress": 3,
        "n_jobs": -1
      },
      "innings": {
        "n_estimators": 100,
        "max_depth": 8,
        "random_state": 42,
        "joblib_compress": 3,
        "n_jobs": -1
      }
    },
    "resources": {
      "training_mb_per_job": 400,
      "tuning_mb_per_job": 500,
      "prediction_mb_per_job": 100,
      "memory_usage_fraction_percent": 80,
      "training_low_memory_threshold_mb": 2560
    },
    "tuning": {
      "cv_splits": 5,
      "n_iter": 40,
      "n_jobs": -1,
      "random_state": 42,
      "scoring": "neg_mean_absolute_error",
      "algorithms": [
        "rf",
        "gb",
        "quantile",
        "et"
      ],
      "validation_method": "walk_forward",
      "timeseries_split_gap": 200,
      "timeseries_small_dataset_threshold": 5000,
      "stability_focus_sample_size_low": 35000,
      "stability_focus_sample_size_high": 80000,
      "stability_violation_weight": 5,
      "stability_focus_bounds": {
        "min_samples_leaf_min": 8,
        "min_samples_leaf_max": 24,
        "learning_rate_max": 0.08,
        "n_estimators_min": 200,
        "mlp_alpha_min": 0.001,
        "mlp_hidden_layer_sizes": [[64, 64], [128, 64], [128, 128, 64]]
      },
      "default_bounds": {
        "min_samples_leaf_min": 4,
        "min_samples_leaf_max": 24,
        "learning_rate_max": 0.2,
        "n_estimators_min": 50,
        "mlp_alpha_min": 0.0001,
        "mlp_hidden_layer_sizes": [[64, 64], [128, 64], [128, 128, 64], [256, 128, 64]]
      },
      "quantile_fallback": {
        "n_estimators": 200,
        "max_depth": 12,
        "alpha": 0.5
      },
      "phase2_fallback_bounds": {
        "n_estimators_min": 100,
        "n_estimators_max": 300,
        "max_depth_min": 8,
        "max_depth_max": 16
      },
      "stability_seed_params": {
        "rf": { "n_estimators": 200, "max_depth": 10, "min_samples_leaf": 12 },
        "gb": { "n_estimators": 300, "max_depth": 4, "learning_rate": 0.02, "min_samples_leaf": 12 },
        "quantile": { "n_estimators": 300, "max_depth": 4, "learning_rate": 0.01, "min_samples_leaf": 11 },
        "et": { "n_estimators": 200, "max_depth": 10, "min_samples_leaf": 12 },
        "hgb": { "max_iter": 200, "max_depth": 6, "learning_rate": 0.03, "min_samples_leaf": 12 },
        "mlp": { "hidden_layer_sizes": [128, 64], "alpha": 0.05, "learning_rate_init": 0.04 }
      },
      "search_space": {
        "rf": {
          "n_estimators": [
            50,
            100,
            150,
            200,
            300
          ],
          "max_depth": [
            6,
            8,
            10,
            12,
            16,
            20,
            null
          ],
          "min_samples_split": [
            2,
            5,
            10
          ],
          "min_samples_leaf": [
            2,
            4,
            6,
            8,
            10
          ]
        },
        "gb": {
          "n_estimators": [
            50,
            100,
            150,
            200
          ],
          "max_depth": [
            3,
            4,
            5,
            6,
            8,
            10,
            12
          ],
          "learning_rate": [
            0.01,
            0.05,
            0.1
          ],
          "min_samples_split": [
            2,
            5
          ],
          "min_samples_leaf": [
            2,
            4,
            6,
            8,
            10
          ]
        },
        "et": {
          "n_estimators": [
            50,
            150,
            300,
            500
          ],
          "max_depth": [
            6,
            10,
            14,
            20
          ],
          "min_samples_split": [
            2,
            5,
            10
          ],
          "min_samples_leaf": [
            4,
            6,
            8,
            10,
            12,
            16
          ]
        }
      },
      "stages": {
        "pycaret": {
          "enabled": true,
          "n_select": 3
        },
        "optuna": {
          "enabled": true,
          "n_trials": 50,
          "pruner": "median"
        },
        "autogluon": {
          "enabled": false,
          "time_limit_seconds": 300,
          "models": [
            "win",
            "extras"
          ]
        },
        "neural": {
          "enabled": true,
          "mlp": true,
          "tabnet": false
        }
      }
    },
    "consistency_regularization": {
      "enabled": false,
      "lambda_runs": 0.01,
      "lambda_wickets": 0.01,
      "models": {}
    },
    "mlqa": {
      "overfitting_delta_threshold": 0.08,
      "stability_fold_std_threshold": 0.05,
      "bias_dip_low": 0.8,
      "bias_dip_high": 1.25,
      "sensitivity_top_weight_threshold": 0.7
    },
    "feature_defaults": {
      "common": {
        "temp": 25,
        "humidity": 50,
        "wind": 0,
        "rain": 0,
        "cloud": 0,
        "pressure": 0,
        "viscosity": 0,
        "inning": 1,
        "session": 1,
        "toss": 0
      },
      "fielding": {
        "consistency": 0.5,
        "form": 0,
        "venue": 0.5,
        "opposition": 0.5
      }
    },
    "prediction_defaults": {
      "economy": 6,
      "default_bowling_deliveries": 24,
      "bowling_deliveries_by_format": {
        "T20": 24,
        "T20I": 24,
        "ODI": 60,
        "TEST": 60
      }
    },
    "reconciliation": {
      "runs_weight": 1.0,
      "wickets_weight": 1.0,
      "soft_favor_top_order_balls": 0.0,
      "max_margin_fraction": 0.4
    },
    "win_coherence": {
      "scale": 25.0
    }
  },
  "team_prediction": {
    "team_size": 11,
    "max_wickets_per_innings": 10
  }
}

