# ml-service environment variables (example)
# Copy to .env and adjust as needed

# Go-app base URL (required for train-on-the-fly when no artifacts are loaded for a format)
# Local dev: go-app on host → http://localhost:8080
# Docker Compose: set in docker-compose.yml to http://go-api:8080
GO_APP_URL=http://localhost:8080
# Optional: API key if go-app backtest routes require X-API-Key (e.g. API_KEY=dev-local-key)
# GO_APP_API_KEY=dev-local-key

# Directory containing trained artifacts (.joblib files)
ML_SERVICE_OUTPUT_DIR=../output/ml-service

# Legacy variable still honored as a fallback (not recommended)
# MODELS_DIR=../output/ml-service

# Path to JSON config file providing inputs/outputs defaults
# ML_SERVICE_CONFIG=./config.json

# Centralized feature vectors config (optional; falls back to defaults if missing)
# FEATURE_CONFIG_PATH=../configs/feature_vectors.json

# Database connection (used by training scripts and migrations)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=cricket_data
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_SSLMODE=disable

# Allow /admin/reload and /admin/train/* endpoints (disabled by default)
ENABLE_HOT_RELOAD=0
# Optional: when set, admin endpoints require X-API-Key header to match (use hmac constant-time compare)
# ADMIN_API_KEY=your-secret-key

# Logging configuration (structlog)
# LOG_LEVEL can be DEBUG, INFO, WARNING, ERROR (default INFO)
LOG_LEVEL=INFO
# LOG_FORMAT can be json or console (default json)
LOG_FORMAT=json
# Requests accept/echo X-Request-ID header and include it in error payloads.
