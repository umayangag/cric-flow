# DEPRECATED: legacy Cricinfo scraper image (unused)
# This Dockerfile is retained only for historical reference. The active ingestion
# path uses Cricsheet JSON via cmd/cricsheet-importer and the API endpoint
# POST /import/cricsheet. This file is not built anywhere in the current Makefiles/CI.
#
# If you wish to completely remove it, delete this file. Keeping it carries no
# build/runtime impact.

# syntax=docker/dockerfile:1
FROM golang:1.22-alpine AS build
WORKDIR /app
COPY go.mod .
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
# Note: cmd/scraper is guarded by //go:build legacy_cricinfo and doesn't compile in normal builds.
RUN --mount=type=cache,target=/go/pkg/mod CGO_ENABLED=0 go build -tags legacy_cricinfo -o /out/scraper ./cmd/scraper

FROM gcr.io/distroless/base-debian12
WORKDIR /
COPY --from=build /out/scraper /scraper
ENTRYPOINT ["/scraper"]
