{
  "inputs": {
    "cricsheet_dir": "../data/go-app/cricsheet"
  },
  "outputs": {
    "export_dir": "../output/go-app"
  },
  "formats": {
    "treat_t20i_as_subset": true,
    "international_teams": [
      "Afghanistan", "Australia", "Bangladesh", "England", "India", "Ireland",
      "New Zealand", "Pakistan", "South Africa", "Sri Lanka", "West Indies", "Zimbabwe"
    ]
  },
  "features": {
    "precompute_timeout_ms": 300000,
    "min_batting_innings": 1,
    "min_bowling_innings": 1,
    "form_shrinkage_alpha": 0.0,
    "consistency_per_format": false
  },
  "export": {
    "split_by_format": true,
    "required_format": ""
  },
  "team": {
    "min_bowlers": 5,
    "default_batters": 6,
    "default_bowlers": 5
  }
}