{
  "inputs": {
    "cricsheet_dir": "../data/go-app/cricsheet"
  },
  "outputs": {
    "export_dir": "../output/go-app"
  },
  "formats": {
    "treat_t20i_as_subset": true,
    "international_teams": [
      "Afghanistan", "Australia", "Bangladesh", "England", "India", "Ireland",
      "New Zealand", "Pakistan", "South Africa", "Sri Lanka", "West Indies", "Zimbabwe"
    ]
  },
  "features": {
    "precompute_timeout_ms": 300000,
    "min_batting_innings": 5,
    "min_bowling_innings": 5,
    "form_shrinkage_alpha": 0.0,
    "consistency_per_format": false
  },
  "export": {
    "split_by_format": true,
    "required_format": ""
  },
  "team": {
    "min_bowlers": 5,
    "default_batters": 6,
    "default_bowlers": 5
  },
  "weather": {
    "enabled": false,
    "rate_limit_per_sec": 0,
    "max_attempts": 0,
    "geocode_cache_only": true,
    "overwrite_existing": false,
    "whitelist_venues": [],
    "mocks": {
      "temp": 28,
      "wind": 12,
      "rain": 0,
      "humidity": 62,
      "cloud": 30,
      "pressure": 1012,
      "viscosity": 1,
      "session": 2
    }
  },
  "predictor": {
    "team_size": 11,
    "default_extras": 14.26
  },
  "selection": {
    "default_pool_csv": "../ml-service/ml/pool.csv",
    "require_keeper": false
  },
  "database": {
    "host": "localhost",
    "port": "5432",
    "name": "cricket_data",
    "user": "postgres",
    "password": "postgres",
    "sslmode": "disable"
  }
}