{
  "inputs": {
    "cricsheet_dir": "../data/go-app/cricsheet",
    "cricsheet_source_url": "https://cricsheet.org/downloads/all_json.zip"
  },
  "outputs": {
    "dir": "output/go-app"
  },
  "server": {
    "train_step_timeout_min": 43200,
    "http_write_timeout_sec": 3600
  },
  "formats": {
    "treat_t20i_as_subset": true,
    "international_teams": [
      "Afghanistan",
      "Australia",
      "Bangladesh",
      "England",
      "India",
      "Ireland",
      "New Zealand",
      "Pakistan",
      "South Africa",
      "Sri Lanka",
      "West Indies",
      "Zimbabwe"
    ]
  },
  "team": {
    "min_bowlers": 5,
    "default_batters": 6,
    "default_bowlers": 5
  },
  "predictor": {
    "team_size": 11
  },
  "pool": {
    "recency_months": {
      "TEST": 12,
      "ODI": 12,
      "T20": 12,
      "T20I": 9
    },
    "retirement": {
      "inactive_years": 5,
      "age_bound_years": {
        "TEST": 40,
        "ODI": 40,
        "T20": 42,
        "T20I": 40
      },
      "age_inactive_years": 2
    }
  },
  "pipeline": {
    "import_timeout_ms": 86400000,
    "import_concurrency": 0
  },
  "resources": {
    "memory_usage_fraction_percent": 85
  }
}
