# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS build
WORKDIR /app
COPY go.mod .
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod CGO_ENABLED=0 go build -o /out/api ./cmd/api

# Final stage: alpine so we can use an entrypoint script to log exit code (137 = likely OOM).
# Kept as fallback when the watcher container is not run (see docs/quality-and-debugging.md).
FROM alpine:3.20
RUN apk --no-cache add ca-certificates
WORKDIR /
COPY --from=build /out/api /api
COPY --from=build /app/config.json /config.json
COPY --from=build /app/migrations /migrations
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
# Writable output dir for pipeline export-dataset (bind-mount to host ./output in compose).
RUN mkdir -p /output/go-app && chown -R 65532:65532 /output
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/entrypoint.sh"]
