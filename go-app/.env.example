# go-app environment variables (example)
# Copy to .env and adjust as needed

# Database connection (used by API/tools where applicable)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=cricket_data
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_SSLMODE=disable

# Centralized feature vectors config (shared with ml-service)
# Both services read this file to determine the ordered feature names.
# If omitted, go-app will try a sensible default relative to the repo root.
# The loader validates names against internal/contracts JSON tags.
# FEATURE_CONFIG_PATH=../configs/feature_vectors.json

# Memory limit for resource-aware pipeline concurrency (precompute, import, seqcalc). Make default: 2GiB.
# GOMEMLIMIT=2GiB
